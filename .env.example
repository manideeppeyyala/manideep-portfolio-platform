# ==========================================================================
# Environment variables
#
# Copy to `.env.local` for local development, and add the same values in
# Vercel → Settings → Environment Variables for production.
#
# NEVER commit .env.local — it's already in .gitignore.
# ==========================================================================


# --------------------------------------------------------------------------
# ADMIN AUTHENTICATION  (required for /admin)
# --------------------------------------------------------------------------
# Generate both of these in one step:
#
#     npm run hash-password
#
# ADMIN_PASSWORD_HASH is a scrypt hash — your actual password is never
# stored anywhere. AUTH_SECRET signs the session cookie; changing it signs
# you out everywhere.

ADMIN_PASSWORD_HASH=
AUTH_SECRET=


# --------------------------------------------------------------------------
# CONTENT STORAGE  (required in production)
# --------------------------------------------------------------------------
# Content, messages and uploads are stored as JSON/files in your GitHub
# repository, written through the GitHub Contents API. Every admin save is
# a real commit, so you get full version history and rollback for free —
# with no database service and no card on file.
#
# Leave these empty in local development and the same data is read/written
# from the local `data/` folder instead.
#
# GITHUB_TOKEN: a fine-grained personal access token
#   github.com/settings/tokens?type=beta
#   → Repository access: only this repository
#   → Permissions → Repository → Contents: Read and write
#   Nothing else needs to be granted.

GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main


# --------------------------------------------------------------------------
# SITE URL  (recommended)
# --------------------------------------------------------------------------
# Used for canonical URLs, OpenGraph tags and sitemap.xml.
# Local:      http://localhost:3000
# Production: https://your-domain.com
#
# If unset, the app falls back to VERCEL_URL, then localhost — so previews
# work without configuration.

NEXT_PUBLIC_SITE_URL=
